<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText android:id="@+id/etTextoLinha"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Digite o texto ou número"
        android:inputType="textCapSentences"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_search"
        android:padding="10dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tamanho da fonte: " android:textSize="14sp" />
        <TextView android:id="@+id/tvFonteVal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="22pt" android:textStyle="bold" android:textSize="14sp"
            android:textColor="@color/primary" />
    </LinearLayout>

    <SeekBar android:id="@+id/sbFonte"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:max="40" android:progress="8"
        android:layout_marginBottom="16dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <CheckBox android:id="@+id/cbNegrito"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Negrito" />
        <CheckBox android:id="@+id/cbCentralizado"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Centralizado" />
    </LinearLayout>

</LinearLayout>
